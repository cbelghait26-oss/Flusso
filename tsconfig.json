{
  "compilerOptions": {
    "lib": ["esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-native",
    "target": "ES2017"
  },
  "include": [
    "App.tsx",
    "index.js",
    "screens/**/*.ts",
    "screens/**/*.tsx",
    "modules/**/*.ts",
    "modules/**/*.tsx"
  ],
  "exclude": [
    "node_modules"
  ]
}
