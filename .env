# ── Firebase (shared across Expo and Next.js) ────────────────────────────────
# Real values must be set in Netlify dashboard > Site configuration > Environment variables
# (do not commit actual keys here — use .env.local for local development)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Next.js aliases (read by Next.js build on Netlify)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Google OAuth ──────────────────────────────────────────────────────────────
EXPO_PUBLIC_GOOGLE_CLIENT_ID=402208533063-jk5a2gdeqina4u0lb5cjpd7f1kh8a4k4.apps.googleusercontent.com

EXPO_PUBLIC_SPOTIFY_CLIENT_ID=f95c8effcc63427e8b98c6a92a9d0c17
EXPO_PUBLIC_SPOTIFY_REDIRECT_URI=flusso://spotify-auth/

# ── RevenueCat ────────────────────────────────────────────────────────────────
# iOS public SDK key (safe to bundle — not a secret)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_PBQnvThPlTmWTQRMFWaMryBrIks
# Android: add your Android public key here when ready
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_REPLACE_WITH_YOUR_RC_ANDROID_PUBLIC_KEY
# Must match exactly the entitlement identifier in the RC dashboard
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=Flusso Pro
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=default
